+# ─── Touch-semantics trigger candidates ─────────────────────────────────────
+
+# Decimal tolerance for comparing trigger prices against book prices that
+# round-tripped through the ZSET score encoding (float * 1e9). 1e-8 is far
+# below any sane tick size yet well above binary float noise at those scales.
+TOUCH_EPS = Decimal("1e-8")
+
+
+async def _load_plain_stop_meta(
+    redis: Redis,
+    order_ids: list[int],
+) -> dict[int, dict[str, str]]:
+    """Bulk-load decoded order HASHes for plain-stop candidates.
+
+    Returns ``{order_id: hash_dict}`` with str keys/values; members without
+    a HASH (phantoms) are omitted.
+    """
+    if not order_ids:
+        return {}
+    pipe = redis.pipeline(transaction=False)
+    for oid in order_ids:
+        pipe.hgetall(ORDER_HASH_KEY.format(order_id=oid))
+    replies = await pipe.execute()
+    out: dict[int, dict[str, str]] = {}
+    for oid, raw in zip(order_ids, replies, strict=True):
+        if not raw:
+            continue
+        out[oid] = {
+            (k.decode() if isinstance(k, bytes) else k):
+                (v.decode() if isinstance(v, bytes) else v)
+            for k, v in raw.items()
+        }
+    return out
+
+
+def _dec(value: str | float | None) -> Decimal | None:
+    try:
+        if value is None:
+            return None
+        return Decimal(value if isinstance(value, str) else str(value))
+    except Exception:
+        return None
+
+
+async def get_touch_trigger_candidates(
+    redis: Redis,
+    symbol: str,
+    *,
+    best_bid: Decimal | None,
+    best_ask: Decimal | None,
+) -> list[int]:
+    """Plain stops satisfying TOUCH semantics against the live book.
+
+    Directional rules (complement the last-trade-price rules of
+    :func:`get_all_triggered_stops`):
+
+      * BUY stop fires when the ask side reached its trigger —
+        you can already buy at/below ``stop_price``: fires iff
+        ``best_ask <= stop_price`` → candidates sit at
+        ``score >= best_ask_score`` and their HASH side must be "buy".
+      * SELL stop fires when the bid side reached its trigger —
+        you can already sell at/above ``stop_price``: fires iff
+        ``best_bid >= stop_price`` → candidates at
+        ``score <= best_bid_score``, HASH side "sell".
+
+    The numeric condition is re-verified from the HASH ``stop_price``
+    (exact decimal string), tolerating ``TOUCH_EPS`` float noise.
+    Returns order ids only; callers must still pass them through
+    ``_trigger_stop_order`` which re-verifies direction (defense-in-depth).
+    """
+    key = stops_key(symbol)
+    ordered_ids: list[int] = []
+
+    if best_ask is not None:
+        # stop_price >= best_ask → buy-touch candidates
+        members = await redis.zrangebyscore(
+            key, float(best_ask) * SCORE_MULTIPLIER, "+inf",
+        )
+        meta = await _load_plain_stop_meta(redis, [int(m) for m in members])
+        for m in members:
+            oid = int(m)
+            h = meta.get(oid)
+            if h is None:
+                continue  # phantom
+            side = h.get("side", "").lower()
+            if side != OrderSide.BUY.value:
+                continue
+            stop = _dec(h.get("stop_price"))
+            if stop is None or stop <= 0:
+                continue
+            # ask <= stop (+eps for score-encoding noise)
+            if best_ask <= stop + TOUCH_EPS:
+                ordered_ids.append(oid)
+
+    if best_bid is not None:
+        # stop_price <= best_bid → sell-touch candidates
+        members = await redis.zrangebyscore(
+            key, 0, float(best_bid) * SCORE_MULTIPLIER,
+        )
+        meta = await _load_plain_stop_meta(redis, [int(m) for m in members])
+        for m in members:
+            oid = int(m)
+            h = meta.get(oid)
+            if h is None:
+                continue  # phantom
+            side = h.get("side", "").lower()
+            if side != OrderSide.SELL.value:
+                continue
+            stop = _dec(h.get("stop_price"))
+            if stop is None or stop <= 0:
+                continue
+            # bid >= stop (-eps)
+            if best_bid >= stop - TOUCH_EPS:
+                ordered_ids.append(oid)
+
+    return ordered_ids
+
