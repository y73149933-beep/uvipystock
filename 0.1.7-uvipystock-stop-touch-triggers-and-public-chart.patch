@@ -0,0 +1,221 @@
+"""Regression tests for TOUCH-semantics stop triggering.
+
+Covers the reported bug: account A places BUY stop_market with trigger 100,
+account B places SELL LIMIT at 100 — no trade ever prints, yet the stop
+must fire (its activation condition is met by RESTING liquidity).
+
+Layers tested:
+
+* ``stops.get_touch_trigger_candidates`` — Redis-side candidate selection:
+  directional rules (buy ← ask ≤ stop; sell ← bid ≥ stop), side separation,
+  phantom members skipped, no fire without book prices.
+* ``StopMonitorService._evaluate_symbol_stops`` — service wiring: the fired
+  candidate reaches ``_trigger_stop_order`` flagged as source="touch"
+  (the PG conversion itself stays unmocked here — covered by integration).
+"""
+from __future__ import annotations
+
+import sys
+from decimal import Decimal
+from pathlib import Path
+
+import pytest_asyncio
+from fakeredis.aioredis import FakeRedis
+
+_BACKEND = Path(__file__).resolve().parents[2]
+if str(_BACKEND) not in sys.path:
+    sys.path.insert(0, str(_BACKEND))
+
+SYM = "BTC/USD"
+
+
+@pytest_asyncio.fixture
+async def redis():
+    r = FakeRedis(decode_responses=True)
+    yield r
+    await r.flushall()
+
+
+async def seed_resting_limit(
+    redis, order_id: int, side: str, price: str, quantity: str = "1",
+) -> None:
+    """Insert a resting LIMIT order into the public book (maker)."""
+    from app.redis_client import orderbook
+
+    p = Decimal(price)
+    key = orderbook.bids_key(SYM) if side == "buy" else orderbook.asks_key(SYM)
+    await redis.zadd(key, {str(order_id): orderbook.encode_score(p, 1)})
+    await redis.hset(orderbook.order_hash_key(order_id), mapping={
+        "order_id": str(order_id),
+        "user_id": "999",
+        "symbol": SYM,
+        "side": side,
+        "type": "limit",
+        "price": price,
+        "quantity": quantity,
+        "is_iceberg": "0",
+    })
+
+
+async def seed_pending_stop(
+    redis, order_id: int, side: str, stop_price: str, otype: str = "stop_market",
+) -> None:
+    """Register a pending conditional order exactly like the API would."""
+    from app.redis_client import orderbook, stops
+
+    await orderbook.store_order_hash(redis, order_id, {
+        "order_id": str(order_id),
+        "user_id": "111",
+        "symbol": SYM,
+        "side": side,
+        "type": otype,
+        "stop_price": stop_price,
+        "quantity": "2",
+        "is_iceberg": "0",
+    })
+    await stops.add_stop_order(redis, order_id, SYM, Decimal(stop_price))
+
+
+# ─── Redis-side candidate selection ──────────────────────────────────────────
+
+async def test_buy_stop_fires_when_ask_touches_trigger(redis):
+    """THE bug scenario: B's Sell Limit @100 activates A's Buy Stop @100."""
+    from app.redis_client import stops
+
+    await seed_resting_limit(redis, 22, "sell", "100")   # account B
+    await seed_pending_stop(redis, 501, "buy", "100")    # account A
+
+    cands = await stops.get_touch_trigger_candidates(
+        redis, SYM, best_bid=None, best_ask=Decimal("100"),
+    )
+    assert cands == [501]
+
+
+async def test_sell_stop_fires_when_bid_touches_trigger(redis):
+    """Mirror case: resting Bid @101 activates a Sell Stop @101."""
+    from app.redis_client import stops
+
+    await seed_resting_limit(redis, 33, "buy", "101")
+    await seed_pending_stop(redis, 502, "sell", "101")
+
+    cands = await stops.get_touch_trigger_candidates(
+        redis, SYM, best_bid=Decimal("101"), best_ask=None,
+    )
+    assert cands == [502]
+
+
+async def test_sides_do_not_cross_fire(redis):
+    """A sell stop above the market must NOT fire from an ask touch;
+    a buy stop below it must NOT fire from a bid touch."""
+    from app.redis_client import stops
+
+    await seed_resting_limit(redis, 22, "sell", "100")
+    await seed_resting_limit(redis, 33, "buy", "99")
+    await seed_pending_stop(redis, 601, "sell", "105")   # bid nowhere near
+    await seed_pending_stop(redis, 602, "buy", "95")     # ask (100) > stop(95)?
+    # careful: buy fires when best_ask <= stop → 100 <= 95 is False
+
+    cands = await stops.get_touch_trigger_candidates(
+        redis, SYM, best_bid=Decimal("99"), best_ask=Decimal("100"),
+    )
+    assert cands == []
+
+
+async def test_ask_below_stop_also_fires_buy(redis):
+    """Or-better activation: gapped-down ask satisfies a higher buy stop."""
+    from app.redis_client import stops
+
+    await seed_resting_limit(redis, 22, "sell", "97")
+    await seed_pending_stop(redis, 701, "buy", "100")
+
+    cands = await stops.get_touch_trigger_candidates(
+        redis, SYM, best_bid=None, best_ask=Decimal("97"),
+    )
+    assert cands == [701]
+
+
+async def test_empty_book_never_selects(redis):
+    from app.redis_client import stops
+
+    await seed_pending_stop(redis, 801, "buy", "100")
+    await seed_pending_stop(redis, 802, "sell", "90")
+
+    cands = await stops.get_touch_trigger_candidates(
+        redis, SYM, best_bid=None, best_ask=None,
+    )
+    assert cands == []
+
+
+async def test_phantom_member_skipped(redis):
+    """ZSET member without an order HASH cannot be verified → skipped."""
+    from app.redis_client import stops
+
+    await redis.zadd(stops.stops_key(SYM), {
